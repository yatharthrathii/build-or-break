<?xml version="1.0" encoding="utf-8"?>
<!--
    The strip: two columns by one row. The next step and a tick, for a home
    screen with no room for a card. Pulled taller it becomes the card.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="110dp"
    android:minHeight="48dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="48dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description_small"
    android:previewLayout="@layout/widget_preview_small"
    android:initialLayout="@layout/widget_loading"
    android:updatePeriodMillis="1800000"
    tools:targetApi="s" />
