<?xml version="1.0" encoding="utf-8"?>
<!--
    The tall one: four columns by four rows. The card, and the rest of the
    day under it. Squeezed down it becomes the card, then the strip.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="250dp"
    android:minHeight="230dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="48dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description_large"
    android:previewLayout="@layout/widget_preview_large"
    android:initialLayout="@layout/widget_loading"
    android:updatePeriodMillis="1800000"
    tools:targetApi="s" />
