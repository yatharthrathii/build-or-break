<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for the tall one. Static, because the picker has no data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_kicker"
        android:textColor="#605D5D"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_preview_time"
        android:textColor="#EC3013"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_title"
        android:textColor="#201E1D"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- An ImageView, not a View: a plain View is not on RemoteViews' list, and
         the picker shows "could not load" for the whole preview if it meets one. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="#D7D3D3"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_row_one"
        android:textColor="#605D5D"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_preview_row_two"
        android:textColor="#605D5D"
        android:textSize="12sp" />
</LinearLayout>
