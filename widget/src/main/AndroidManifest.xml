<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Exported, because a widget host is another process and has to be
            able to reach it. That is the whole of its surface: it takes no
            extras and every action it offers goes through a callback this app
            registered itself.
        -->
        <receiver
            android:name=".TodayWidgetReceiver"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

    </application>

</manifest>
