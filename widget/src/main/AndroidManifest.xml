<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Exported, because a widget host is another process and has to be
            able to reach them. That is the whole of their surface: they take
            no extras and every action they offer goes through a callback this
            app registered itself.

            Three receivers for one widget, so the picker offers three sizes.
            The first keeps its name so a widget placed before the other two
            existed survives the update.
        -->
        <receiver
            android:name=".TodayWidgetReceiver"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".NextStepWidgetReceiver"
            android:label="@string/widget_name_small"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_step_widget_info" />
        </receiver>

        <receiver
            android:name=".WholeDayWidgetReceiver"
            android:label="@string/widget_name_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/whole_day_widget_info" />
        </receiver>

    </application>

</manifest>
