<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions are declared in :scheduler, with the code that uses them and
        with the tier that degrades when one is missing. techspec.md section 7.
        They merge into this manifest at build time.
    -->

    <application
        android:name=".BuildOrBreakApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuildOrBreak.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.BuildOrBreak.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Rescheduling on launch is the second path to work the daily job also
            does. WorkManager is best effort and a vendor battery manager may
            stop it for days, so the pass runs here too. It is idempotent, which
            is what makes the redundancy free.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.buildorbreak.app.startup.SchedulerStartup"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
