    <string name="onboarding_welcome_title">आप 40 मिनट\nलेट उठे।</string>
    <string name="onboarding_welcome_body">बाकी हर रूटीन ऐप अब आपको लाल निशानों की लाइन दिखाएगा। यह ऐप बचा हुआ दिन खुद आगे खिसका देता है, और बताता है कि क्या खिसकाया।</string>
    <string name="onboarding_before_kicker">आम तौर पर क्या होता है</string>
    <string name="onboarding_before_body">नौ अलार्म उन्हीं टाइम पर बजते हैं जो आपने पिछले महीने सेट किए थे। छह छूट जाते हैं, सुबह नौ बजे तक पिछड़ने का एहसास हो जाता है, और गुरुवार तक ऐप म्यूट।</string>
    <string name="onboarding_after_kicker">यहाँ क्या होता है</string>
    <string name="onboarding_after_body">आप बताते हैं कि लेट हैं। जिम अपनी जगह रहता है, क्योंकि वह बुक है। उससे जुड़ा हर स्टेप आपके साथ खिसकता है। जो कर लिया, उसका अलार्म दोबारा नहीं बजता।</string>
    <string name="onboarding_point_1_title">स्टेप जो एक-दूसरे को जानते हैं</string>
    <string name="onboarding_point_1_body">फिक्स टाइम, "जिम के 20 मिनट बाद", या एक विंडो जिसमें कभी भी। एक खिसकाओ, सही वाले साथ चलते हैं।</string>
    <string name="onboarding_point_2_title">अलार्म जो सच में उठाते हैं</string>
    <string name="onboarding_point_2_body">पूरी स्क्रीन, बढ़ती आवाज़, लॉक स्क्रीन से ही बंद। और अगर फोन की सेटिंग यह रोक रही है तो ऐप आपको बता देगा।</string>
    <string name="onboarding_point_3_title">कुछ भी इस फोन से बाहर नहीं</string>
    <string name="onboarding_point_3_body">न अकाउंट, न सिंक, न एनालिटिक्स, न इंटरनेट परमिशन। आपका रूटीन इसी फोन की एक फाइल है।</string>

    <string name="onboarding_start_title">आप क्या बनाना\nचाहते हैं?</string>
    <string name="onboarding_start_body">जो सबसे करीब लगे वह चुनें। खाली स्क्रीन नहीं, पूरा दिन मिलेगा जिसे आप बदल सकते हैं। हर स्टेप बाद में बदला जा सकता है।</string>
    <string name="onboarding_choice_morning_kicker">ज़्यादातर लोग यहीं से शुरू करते हैं</string>
    <string name="onboarding_choice_morning_title">सुबह जो हाथ से न निकले</string>
    <string name="onboarding_choice_morning_body">उठना, स्ट्रेच, नाश्ता, और रात को टाइम पर दिन खत्म करना।</string>
    <string name="onboarding_choice_study_kicker">एग्ज़ाम, कोर्स, कोई स्किल</string>
    <string name="onboarding_choice_study_title">पढ़ाई जो सच में होती है</string>
    <string name="onboarding_choice_study_body">दो डीप ब्लॉक, रिवीज़न, प्रैक्टिस, और खराब दिन के लिए हर एक का छोटा वर्ज़न।</string>
    <string name="onboarding_choice_fitness_kicker">ट्रेनिंग और खाना</string>
    <string name="onboarding_choice_fitness_title">जिम, खाना और नींद</string>
    <string name="onboarding_choice_fitness_body">पिन किया जिम स्लॉट, उसके बाद प्रोटीन, शाम की वॉक और फिक्स सोने का टाइम।</string>
    <string name="onboarding_choice_paste_kicker">सबसे तेज़, अगर पहले से है</string>
    <string name="onboarding_choice_paste_title">AI चैट से रूटीन पेस्ट करें</string>
    <string name="onboarding_choice_paste_body">टेक्स्ट डालें। ऐप टाइम, ऑफसेट और विंडो पढ़ेगा, और सेव करने से पहले दिखाएगा कि क्या समझा।</string>
    <string name="onboarding_paste_example" tools:ignore="TypographyDashes">07:30 | Gym | 60m\n+15m | Protein + shower\n18:00-20:00 | Language drill</string>
    <string name="onboarding_choice_write_kicker">पूरा कंट्रोल</string>
    <string name="onboarding_choice_write_title">खुद लिखूँगा</string>
    <string name="onboarding_choice_write_body">खाली प्लान। पहला स्टेप जोड़ें और चलें।</string>

    <string name="onboarding_preview_title">यह रहा\nआपका दिन।</string>
    <string name="onboarding_preview_body">अभी कुछ सेव नहीं हुआ है। अंदर जाकर कोई भी स्टेप बदल या हटा सकते हैं।</string>
    <plurals name="onboarding_preview_count">
        <item quantity="one">%1$d स्टेप · %2$d बजेगा</item>
        <item quantity="other">%1$d स्टेप · %2$d बजेंगे</item>
    </plurals>
    <string name="onboarding_preview_paste_title">अब आपका\nअपना रूटीन।</string>
    <string name="onboarding_preview_paste_body">परमिशन वाली स्क्रीन के बाद इम्पोर्ट खुलेगा। टेक्स्ट पेस्ट करें, और सेव होने से पहले ऐप हर वह लाइन दिखाएगा जो उसने समझी।</string>
    <string name="onboarding_preview_write_title">अब आपका\nपहला स्टेप।</string>
    <string name="onboarding_preview_write_body">परमिशन वाली स्क्रीन के बाद खाली स्टेप का एडिटर खुलेगा। नाम और टाइम दीजिए, दिन वहीं से बनना शुरू होगा।</string>
    <string name="onboarding_preview_after">ऊपर वाले स्टेप के बाद</string>
    <string name="onboarding_preview_window">%1$s से पहले कभी भी</string>
    <string name="onboarding_preview_every">विंडो में बार-बार</string>
    <string name="onboarding_preview_rings">बजेगा, और पूरी स्क्रीन लेगा</string>
    <string name="onboarding_preview_pinned">दिन खिसके तो भी अपनी जगह</string>

    <string name="onboarding_permissions_title">तीन परमिशन,\nहर एक की वजह</string>
    <string name="onboarding_permissions_body">कोई भी छोड़ सकते हैं। ऐप फिर भी चलेगा, बस थोड़ा चुप रहेगा।</string>
    <string name="perm_alarms_title">अलार्म और रिमाइंडर</string>
    <string name="perm_alarms_body">ताकि स्टेप ठीक उसी मिनट बजे, और दिन खिसकने पर नए मिनट पर फिर बजे।</string>
    <string name="perm_notifications_title">नोटिफिकेशन</string>
    <string name="perm_notifications_body">"अगला स्टेप" की याद और लॉक स्क्रीन पर एक टैप में Done के लिए।</string>
    <string name="perm_battery_title">बैटरी ऑप्टिमाइज़ेशन बंद</string>
    <string name="perm_battery_body">Android बैटरी बचाने के लिए लेट अलार्म चुप कर सकता है। यह 06:40 के अलार्म को 06:40 पर रखता है।</string>
    <string name="perm_autostart_done">हो गया</string>
    <string name="perm_autostart_title">ऑटोस्टार्ट</string>
    <string name="perm_autostart_body">आपका फोन अपनी लिस्ट रखता है कि कौन से ऐप खुद चल सकते हैं। ऐप वह लिस्ट नहीं देख सकता, इसलिए यह लाइन कभी हरी नहीं होगी। रात में अलार्म गायब हों तो अक्सर यही वजह है।</string>
    <string name="perm_allow">अनुमति दें</string>
    <string name="perm_open_settings">सेटिंग खोलें</string>
    <string name="perm_granted">मिल गई</string>
    <string name="onboarding_right_now">अभी: %1$s</string>
    <string name="onboarding_privacy_note">न अकाउंट, न एनालिटिक्स, न इंटरनेट कॉल। आपका प्लान इसी फोन की एक फाइल में रहता है।</string>

