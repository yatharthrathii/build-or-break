<?xml version="1.0" encoding="utf-8"?>
<!--
    Hindi. Simple, spoken Hindi rather than textbook Hindi, because this is read
    at six in the morning. Every key mirrors values/strings.xml; a key missing
    here falls back to English, so nothing breaks if a translation lags.

    The import format keywords inside the starter routines (alarm, pinned,
    min:) stay in English on purpose: the parser reads them.
-->
