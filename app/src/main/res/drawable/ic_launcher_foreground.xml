<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark: one slash.

    BUILD/BREAK is the line between the two, so the mark is that line and
    nothing else. A single stroke survives being shrunk to a 24dp notification
    glyph, masked into a circle by one launcher and a squircle by the next, and
    flattened to a silhouette for a themed icon. Two shapes would not.

    The parallelogram is inscribed in the 66dp safe circle of the 108dp
    adaptive canvas, so no launcher shape can clip a tip off it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M31.2,74.4 L67.2,26.4 L76.8,33.6 L40.8,81.6 Z" />
</vector>
