<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark: a block, broken.

    A solid square with one slash cut clean through it. The square is the
    thing built, the slash is the break, and the two halves are what is left
    either way. It is the wordmark's slash given something to cut, because a
    slash on its own read as a "no entry" sign from across a room, and a
    routine app whose icon says "no" is off to a bad start.

    Two polygons and nothing else, so it survives every launcher mask, the
    24dp notification glyph and the monochrome themed icon as the same shape.
    The square is inscribed in the 66dp safe circle of the 108dp adaptive
    canvas: every corner sits inside the mask, whatever shape the mask is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The upper half, above the cut. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M31,31 H72 L31,72 Z" />

    <!-- The lower half, below it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M77,77 H36 L77,36 Z" />
</vector>
