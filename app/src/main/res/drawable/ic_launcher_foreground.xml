<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark: a square of accent with the slash cut through it in ink.

    The slash is the identity. BUILD/BREAK is about the line between the two,
    and one diagonal says so at 48dp without a letter, a clock or a tick.
    Hard cornered, like everything else.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The square -->
    <path
        android:fillColor="@color/accent"
        android:pathData="M30,30 H78 V78 H30 Z" />

    <!-- The slash, cut from upper right to lower left -->
    <path
        android:fillColor="@color/ink"
        android:pathData="M64,26 L72,26 L44,82 L36,82 Z" />
</vector>
