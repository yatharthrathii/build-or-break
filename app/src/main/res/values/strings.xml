    <string name="onboarding_paste_example" tools:ignore="TypographyDashes">07:30 | Gym | 60m\n+15m | Protein + shower\n18:00-20:00 | Language drill</string>
    <string name="onboarding_choice_write_kicker">Full control</string>
    <string name="onboarding_choice_write_title">Write it myself</string>
    <string name="onboarding_choice_write_body">A blank plan. Add the first step and go.</string>

