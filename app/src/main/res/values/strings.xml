<?xml version="1.0" encoding="utf-8"?>
<!--
    rules.md section 9: every user visible string lives here from the first
    commit. No hardcoded strings in composables, ever, so that adding Hindi and
    a Hinglish variant in V1.5 is a translation job and not a refactor.

    rules.md section 2 governs the wording: short, second person, present tense,
    no em dash, no en dash, no exclamation marks, no filler adjectives.
-->
<resources>
    <string name="app_name">Build or Break</string>

    <!-- Today -->
    <string name="today_subtitle">%1$s · %2$s</string>

    <!--
        A plural rather than one string. English does not inflect here, but Hindi
        does, and rules.md wants a translator to be able to do their job without
        anybody reopening the Kotlin.
    -->
    <plurals name="today_done_count">
        <item quantity="one">%1$d of %2$d done</item>
        <item quantity="other">%1$d of %2$d done</item>
    </plurals>
    <string name="today_action_done">Done</string>
    <string name="today_action_snooze">Snooze</string>
    <string name="today_action_skip">Skip</string>
    <string name="today_notice_fix">Fix</string>

    <string name="today_empty_title">Nothing today</string>
    <string name="today_empty_body">This template has no steps that run on this weekday.</string>

    <string name="today_no_plan_title">No plan yet</string>
    <string name="today_no_plan_body">Paste in the routine you already have and this will run it.</string>
    <string name="today_import">Import a routine</string>
    <string name="today_open_plan">Plan</string>

    <!--
        Budget. Counts rather than a percentage, because "4 of 11" can be checked
        against the list and a percentage has to be taken on trust.
    -->
    <plurals name="budget_too_many_alarms">
        <item quantity="one">%1$d alarm today. More than three and they stop landing.</item>
        <item quantity="other">%1$d alarms today. More than three and they stop landing.</item>
    </plurals>

    <plurals name="budget_too_many_notifications">
        <item quantity="one">%1$d notification today. That is a lot to hear.</item>
        <item quantity="other">%1$d notifications today. That is a lot to hear.</item>
    </plurals>

    <!--
        Reliability. Every line says what is lost rather than which permission is
        missing, because somebody reading this after a missed alarm wants to know
        whether it will happen again.
    -->
    <string name="tier_full_screen_headline">Alarms will work</string>
    <string name="tier_full_screen_body">A step set to alarm will take over the screen, ring and get louder until you deal with it.</string>

    <string name="tier_heads_up_headline">Alarms will arrive on time</string>
    <string name="tier_heads_up_body">Alarms arrive at the right minute with sound, but cannot take over the screen. Enough for a reminder, easy to sleep through.</string>
    <string name="tier_heads_up_short">Alarms arrive on time but will not take over the screen.</string>

    <string name="tier_inexact_headline">Alarms may be late</string>
    <string name="tier_inexact_body">Android is batching this app\'s alarms, so a step due at 06:30 may arrive at 06:45 or later. The app will not pretend otherwise.</string>
    <string name="tier_inexact_short">Alarms may arrive several minutes late.</string>

    <string name="tier_in_app_headline">Nothing will reach you</string>
    <string name="tier_in_app_body">Notifications are off, so the routine only exists while this app is open. Nothing will be delivered.</string>
    <string name="tier_in_app_short">Nothing will reach you outside this app.</string>

    <string name="reliability_what_would_change">What would change that</string>

    <string name="fix_notifications_what">Turn notifications on</string>
    <string name="fix_notifications_why">Without them nothing can be delivered at all.</string>

    <string name="fix_channel_what">Turn the Alarms channel back up</string>
    <string name="fix_channel_why">It is set to silent, so alarms arrive without a sound.</string>

    <string name="fix_exact_what">Allow alarms and reminders</string>
    <string name="fix_exact_why">Without it Android decides when to deliver, which can be fifteen minutes late.</string>

    <string name="fix_full_screen_what">Allow full screen alarms</string>
    <string name="fix_full_screen_why">Alarms will still ring, but will not wake the screen.</string>

    <string name="fix_battery_what">Remove battery restrictions</string>
    <string name="fix_battery_why">Your phone may stop this app overnight, whatever else is allowed.</string>

    <string name="fix_open_notification_settings">Open notification settings</string>
    <string name="fix_open_alarm_settings">Open alarm settings</string>
    <string name="fix_open_app_settings">Open app settings</string>
    <string name="fix_open_battery_settings">Open battery settings</string>

    <!--
        The one switch no API can see the state of. The copy says so plainly,
        because claiming to know would be worse than admitting the gap.
    -->
    <string name="autostart_title">Allow autostart</string>
    <string name="autostart_body">Your phone keeps its own list of apps allowed to start on their own. This app cannot see that list, so it cannot tell you whether this is already done. If alarms go missing overnight, this is usually why.</string>
    <string name="autostart_action">Open autostart settings</string>

    <!-- Plan editor -->
    <string name="plan_none_title">No plan yet</string>
    <string name="plan_none_body">Bring in the routine you already have. Whatever you wrote, or whatever an AI tool wrote for you.</string>
    <string name="plan_import">Import a routine</string>

    <string name="plan_empty_title">No steps yet</string>
    <string name="plan_empty_body">Add the first thing your day starts with.</string>

    <string name="plan_add_step">Add step</string>
    <string name="plan_remove">Remove</string>
    <string name="plan_note_pinned">pinned</string>
    <string name="plan_note_minimum">has a smaller version</string>
    <string name="plan_note_separator">" · "</string>

    <!--
        Import. The first thing anybody does, and the reason the app hands out a
        prompt rather than trying to parse every shape of prose.
    -->
    <string name="import_title">Bring in your routine</string>
    <string name="import_body">This app runs a plan you already have. It does not write one for you.</string>

    <string name="import_prompt_title">Easiest way</string>
    <string name="import_prompt_body">Copy this and give it to whichever tool wrote your routine. Paste back what it returns and every line will be read correctly.</string>
    <string name="import_copy_prompt">Copy the prompt</string>
    <!-- Shown in the system clipboard preview on Android 13 and above. -->
    <string name="import_clip_label">Routine format prompt</string>

    <string name="import_paste_label">Your routine</string>
    <string name="import_paste_placeholder">06:30 Wake up
+10m Drink water
07:30-09:30 Study block</string>
    <string name="import_review">Read it</string>

    <string name="import_review_title">Check this is right</string>
    <string name="import_nothing_understood">Nothing here looked like a step. Go back and check the times are on each line.</string>
    <string name="import_note_pinned">pinned</string>
    <string name="import_note_minimum">has a smaller version</string>
    <string name="import_note_separator">" · "</string>
    <string name="import_name_label">Name this routine</string>
    <string name="import_back">Back</string>
    <string name="import_confirm">Save it</string>
    <string name="import_failed">That could not be saved. Try again.</string>

    <plurals name="import_understood_count">
        <item quantity="one">%1$d step understood. Check it before saving.</item>
        <item quantity="other">%1$d steps understood. Check them before saving.</item>
    </plurals>

    <!--
        Never dropped silently. A line the parser could not read is shown, so a
        misread is caught here rather than at six in the morning.
    -->
    <plurals name="import_not_understood_count">
        <item quantity="one">%1$d line was not understood</item>
        <item quantity="other">%1$d lines were not understood</item>
    </plurals>

    <!-- Item editor -->
    <string name="editor_title_label">What is this step</string>
    <string name="editor_when">When</string>
    <string name="editor_at">At</string>
    <string name="editor_from">From</string>
    <string name="editor_to">To</string>
    <string name="editor_every_minutes">Repeat every, minutes</string>
    <string name="editor_offset_minutes">Minutes after</string>
    <string name="editor_after_which">After which step</string>
    <string name="editor_no_parents">There is nothing above this to hang it off. Pick another kind of time.</string>
    <string name="editor_window_backwards">The end is before the start.</string>

    <string name="editor_how_loud">How loud</string>
    <string name="editor_which_days">Which days</string>
    <string name="editor_no_days">On no days, this step will never run.</string>

    <string name="editor_minimum_title">Smaller version</string>
    <string name="editor_minimum_body">Decided now, offered on a bad day. Nobody having one is in a state to work out what a fair smaller version would be.</string>
    <string name="editor_minimum_label">For example, ten minutes</string>

    <string name="editor_pinned_title">Keep this where it is</string>
    <string name="editor_pinned_body">A pinned step does not move when the whole day is shifted.</string>

    <string name="editor_save">Save</string>
    <string name="editor_cancel">Cancel</string>
    <string name="editor_set">Set</string>

    <!-- The four anchor kinds. The one idea this app has that others do not. -->
    <string name="anchor_fixed">At a time</string>
    <string name="anchor_relative">After another step</string>
    <string name="anchor_window">Any time in a window</string>
    <string name="anchor_interval">Repeating</string>

    <string name="salience_alarm">Alarm</string>
    <string name="salience_notify">Notify</string>
    <string name="salience_silent">Silent</string>
    <string name="salience_timeline">Timeline only</string>
</resources>
