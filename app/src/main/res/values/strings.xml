    <!--
        The three starter days, in the app's own import format.

        Read by the same parser a pasted routine goes through, so a starter
        that loads is proof the import works. Each uses several kinds of time,
        keeps at least one thing pinned, and stays inside the daily alarm
        budget so nobody meets a noise warning on their first screen.

        One step per line, and the line breaks have to be escaped. A real
        newline inside a string resource is collapsed to a space by AAPT, which
        once turned an entire routine into one step whose title was the whole
        text. The parser was right; the resource was lying to it.
    -->
    <string name="starter_template">Weekday</string>

    <string name="starter_morning_name">Morning routine</string>
    <string name="starter_morning_text" tools:ignore="TypographyDashes">06:30 | Wake + water | alarm\n+10m | Make the bed | 5m\n06:50-07:20 | Stretch | 15m | min: five minutes\n07:30 | Shower and dress | 20m\n08:00 | Breakfast | 20m | pinned\n08:30 | Plan the day | 10m\n22:30 | Phone away | alarm\n23:00 | Lights out | alarm</string>

    <string name="starter_study_name">Study plan</string>
    <string name="starter_study_text" tools:ignore="TypographyDashes">07:00 | Wake + water | alarm\n08:30 | Revise yesterday | 30m | min: ten minutes\n09:30-11:00 | Deep study block 1 | 60m | alarm\n+20m | Break and walk | 15m\n12:30 | Lunch | 40m | pinned\n14:00-16:00 | Deep study block 2 | 60m | min: twenty minutes\n17:00 | Practice questions | 45m\n20:00-21:30 | Revision | 30m | min: ten minutes\n22:45 | Phone away | alarm</string>

    <string name="starter_fitness_name">Training plan</string>
    <string name="starter_fitness_text" tools:ignore="TypographyDashes">06:15 | Wake + water | alarm\n06:45 | Gym | 60m | alarm | pinned\n+15m | Protein and shower | 15m\n09:00 | Breakfast | 20m\n13:00 | Lunch and walk | 45m | pinned\n16:00 | Water check | 5m\n18:30-20:00 | Evening walk | 30m | min: ten minutes\n22:00 | Stretch | 10m | min: three minutes\n22:45 | Lights out | alarm</string>

