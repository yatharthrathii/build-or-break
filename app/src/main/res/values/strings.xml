    <!--
        Reliability. Every line says what is lost rather than which permission is
        missing, because somebody reading this after a missed alarm wants to know
        whether it will happen again.
    -->
    <string name="reliability_title">Reliability</string>
    <string name="reliability_kicker">What the phone allows</string>
    <string name="tier_full_screen_headline">Alarms will work</string>
    <string name="tier_full_screen_body">A step set to alarm will take over the screen, ring and get louder until you deal with it.</string>
    <string name="tier_full_screen_short">Alarms will ring and take over the screen.</string>

    <string name="tier_heads_up_headline">Alarms will arrive on time</string>
    <string name="tier_heads_up_body">Alarms arrive at the right minute with sound, but cannot take over the screen. Enough for a reminder, easy to sleep through.</string>
    <string name="tier_heads_up_short">Alarms arrive on time but will not take over the screen.</string>

    <string name="tier_inexact_headline">Alarms may be late</string>
    <string name="tier_inexact_body">Android is batching this app\'s alarms, so a step due at 06:30 may arrive at 06:45 or later. The app will not pretend otherwise.</string>
    <string name="tier_inexact_short">Alarms may arrive several minutes late.</string>

    <string name="tier_in_app_headline">Nothing will reach you</string>
    <string name="tier_in_app_body">Notifications are off, so the routine only exists while this app is open. Nothing will be delivered.</string>
    <string name="tier_in_app_short">Nothing will reach you outside this app.</string>

    <string name="reliability_what_would_change">What would change that</string>

