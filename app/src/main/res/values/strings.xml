    <string name="onboarding_permissions_title">Three permissions,\none reason each</string>
    <string name="onboarding_permissions_body">Skip any of them. The app still works, just quieter.</string>
    <string name="perm_alarms_title">Alarms and reminders</string>
    <string name="perm_alarms_body">So a step can ring at an exact minute, and ring again at the new minute when the day shifts.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">For the next up nudge and the one tap Done on the lock screen.</string>
    <string name="perm_battery_title">Ignore battery optimisation</string>
    <string name="perm_battery_body">Android can silence delayed alarms to save power. This keeps a 06:40 alarm at 06:40.</string>
    <string name="perm_autostart_done">I\'ve done it</string>
