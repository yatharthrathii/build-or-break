<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the launch theme lives in XML. Everything after the first frame is
    Compose, driven by :core:designsystem.

    The launch window uses the light ground so the very first frame is already
    the app's own colour, not a white flash.
-->
<resources>
    <style name="Theme.BuildOrBreak.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BuildOrBreak</item>
    </style>

    <!--
        The window painted in the ground colour; values-night swaps the parent
        and the colour. Compose draws every screen, but the window itself
        shows through during a cross fade between two screens and behind a
        sheet as it opens, and a white window under a dark app is a flash of
        light on every tab switch.
    -->
    <style name="Theme.BuildOrBreak" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
