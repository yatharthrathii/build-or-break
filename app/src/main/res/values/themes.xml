<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the launch theme lives in XML. Everything after the first frame is
    Compose, driven by :core:designsystem.
-->
<resources>

    <!--
        The window the system draws before the process is ready.

        It follows the phone's own dark setting, because that is the only thing
        the platform can know at this point: the app's own choice is in a
        database it has not opened yet. MainActivity corrects it for the next
        launch with setSplashScreenTheme, which is what the two explicit
        variants below exist for.
    -->
    <style name="Theme.BuildOrBreak.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.BuildOrBreak</item>
    </style>

    <!-- The same window, pinned to one palette. Chosen at runtime, never in the manifest. -->
    <style name="Theme.BuildOrBreak.Starting.Light" parent="Theme.BuildOrBreak.Starting">
        <item name="windowSplashScreenBackground">#F3F2F2</item>
        <item name="postSplashScreenTheme">@style/Theme.BuildOrBreak</item>
    </style>

    <style name="Theme.BuildOrBreak.Starting.Dark" parent="Theme.BuildOrBreak.Starting">
        <item name="windowSplashScreenBackground">#141312</item>
        <item name="postSplashScreenTheme">@style/Theme.BuildOrBreak</item>
    </style>

    <!--
        The window painted in the ground colour; values-night swaps the parent
        and the colour. Compose draws every screen, but the window itself
        shows through during a cross fade between two screens and behind a
        sheet as it opens, and a white window under a dark app is a flash of
        light on every tab switch.
    -->
    <style name="Theme.BuildOrBreak" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
