<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the handful of colours the Android platform needs before Compose takes
    over: the launcher icon and the splash window. The real palette lives in
    :core:designsystem as Compose tokens.

    Do not add app colours here. If a colour is needed in Compose, it belongs in
    the design system.
-->
<resources>
    <!-- The ground. Matches Light.Ground in the design system. -->
    <color name="ground">#F3F2F2</color>

    <!-- The accent. Matches Light.Accent in the design system. -->
    <color name="accent">#EC3013</color>

    <!-- Ink, for the icon's slash. Matches Light.Ink. -->
    <color name="ink">#201E1D</color>
</resources>
